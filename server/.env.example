# Local development only. Never copy these values to production.
NODE_ENV=development
PORT=8080

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=messenger_dev
DB_PASSWORD=replace-with-a-local-only-random-password
DB_NAME=messenger
DB_SYNCHRONIZE=true

# Generate every value independently: openssl rand -hex 32
JWT_ACCESS_CURRENT_KEY_ID=local-2026-01
JWT_ACCESS_CURRENT_SECRET=replace-with-an-independent-local-secret
JWT_ACCESS_PREVIOUS_KEY_ID=local-previous
JWT_ACCESS_PREVIOUS_SECRET=replace-with-another-independent-local-secret
JWT_ISSUER=mobile-messenger-local
JWT_AUDIENCE=mobile-messenger-local-clients
JWT_ACCESS_EXPIRES_IN=10m
JWT_REFRESH_EXPIRES_IN=30d
OTP_PEPPER=replace-with-an-independent-local-otp-pepper
REFRESH_TOKEN_PEPPER=replace-with-an-independent-local-refresh-pepper
LOG_IP_HASH_KEY=replace-with-an-independent-local-log-key

COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
CORS_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:5173
WS_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:5173
WEB_APP_URL=http://127.0.0.1:3000

E2EE_ENABLED=false
E2EE_REQUIRED=false
LEGACY_MESSAGES_READ_ENABLED=true
PASSWORD_LOGIN_ENABLED=false
ADMIN_IP_ALLOWLIST_ENABLED=false
ADMIN_IP_ALLOWLIST=

AUTH_ENABLE_DEMO_ACCOUNTS=false
AUTH_ALLOW_TEST_CODE=false
AUTH_CODE_TTL_SECONDS=300
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_CODE_RESEND_COOLDOWN_SECONDS=60
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX_REQUESTS=20
CHAT_ENABLE_DEMO_SEEDING=false

VERIFICATION_PROVIDER=console
SMS_PROVIDER=console
SMS_FROM=MobileMsg
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_FROM=
SMS_VONAGE_API_KEY=
SMS_VONAGE_API_SECRET=
SMS_VONAGE_FROM=
SMSRU_API_ID=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ALLOW_TEXT_PHONE_LINKING=false
TELEGRAM_REQUIRE_OWN_CONTACT=true
TELEGRAM_PAIRING_TOKEN_TTL_SECONDS=600
TELEGRAM_LINK_RESEND_COOLDOWN_SECONDS=60
TELEGRAM_ALLOW_RELINK=false

# Local S3-compatible storage is optional, but credentials never have defaults.
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=messenger-media-dev
S3_REGION=us-east-1
S3_TLS_ENABLED=false
S3_FORCE_PATH_STYLE=true

REALTIME_HEARTBEAT_INTERVAL_MS=15000
REALTIME_HEARTBEAT_TIMEOUT_MS=45000

WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=
PUSH_ALLOW_TEST_ENDPOINT=false

APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=com.mobilemessenger.app
APNS_PRIVATE_KEY=
APNS_ENVIRONMENT=sandbox

# Used only by the optional Compose profile: --profile database-tools
PGADMIN_DEFAULT_EMAIL=developer@localhost.invalid
PGADMIN_DEFAULT_PASSWORD=replace-with-a-local-only-pgadmin-password
PGADMIN_PORT=5050
