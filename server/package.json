{
  "name": "mobile-messenger-backend",
  "version": "0.1.0",
  "description": "Minimal backend scaffold for Mobile Messenger iOS client integration",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "start": "node dist/main.js",
    "start:prod": "DOTENV_CONFIG_PATH=.env.production node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint --ext .ts src test",
    "typeorm": "node --require ts-node/register ./node_modules/typeorm/cli.js -d src/database/data-source.ts",
    "typeorm:dist": "node ./node_modules/typeorm/cli.js -d dist/database/data-source.js",
    "migration:generate": "npm run typeorm -- migration:generate src/database/migrations/GeneratedMigration",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:run:dist": "npm run typeorm:dist -- migration:run",
    "migration:run:prod": "DOTENV_CONFIG_PATH=.env.production npm run typeorm:dist -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:revert:dist": "npm run typeorm:dist -- migration:revert",
    "migration:show": "npm run typeorm -- migration:show",
    "migration:show:dist": "npm run typeorm:dist -- migration:show",
    "migration:show:prod": "DOTENV_CONFIG_PATH=.env.production npm run typeorm:dist -- migration:show",
    "test": "npm run test:e2e",
    "test:e2e": "files=$(find test -type f -name '*.test.ts'); if [ -z \"$files\" ]; then echo 'No backend tests found, skipping.'; else node --require ts-node/register --test $files; fi"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1028.0",
    "@aws-sdk/s3-request-presigner": "^3.1028.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/platform-ws": "^10.3.0",
    "@nestjs/typeorm": "^11.0.1",
    "@nestjs/websockets": "^10.3.0",
    "@types/web-push": "^3.6.4",
    "apn": "^2.2.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.28",
    "web-push": "^3.6.7",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.3.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^7.6.0",
    "@typescript-eslint/parser": "^7.6.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "pg-mem": "^3.0.5",
    "prettier": "^3.2.5",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20"
  }
}
