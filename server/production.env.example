# Copy to an ignored file outside Git, chmod 600, and inject real values from
# the Cloudways secret store. Blank values are deliberate fail-closed markers.
NODE_ENV=production
PORT=3001

DATABASE_URL=
DB_SYNCHRONIZE=false

# Generate every secret independently with a CSPRNG. Do not reuse values.
JWT_ACCESS_CURRENT_KEY_ID=
JWT_ACCESS_CURRENT_SECRET=
JWT_ACCESS_PREVIOUS_KEY_ID=
JWT_ACCESS_PREVIOUS_SECRET=
JWT_ISSUER=mobile-messenger-api
JWT_AUDIENCE=mobile-messenger-clients
JWT_ACCESS_EXPIRES_IN=10m
JWT_REFRESH_EXPIRES_IN=30d
OTP_PEPPER=
REFRESH_TOKEN_PEPPER=
LOG_IP_HASH_KEY=

COOKIE_SECURE=true
COOKIE_SAME_SITE=strict
CORS_ORIGINS=https://messenger.example.com
WS_ORIGINS=https://messenger.example.com
WEB_APP_URL=https://messenger.example.com

# Production stays fail-closed until the protocol decision and interoperability
# tests in docs/E2EE_ARCHITECTURE.md have been completed.
E2EE_ENABLED=true
E2EE_REQUIRED=true
LEGACY_MESSAGES_READ_ENABLED=false
PASSWORD_LOGIN_ENABLED=false
ADMIN_IP_ALLOWLIST_ENABLED=true
ADMIN_IP_ALLOWLIST=

AUTH_ENABLE_DEMO_ACCOUNTS=false
AUTH_ALLOW_TEST_CODE=false
AUTH_CODE_TTL_SECONDS=300
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_CODE_RESEND_COOLDOWN_SECONDS=60
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX_REQUESTS=20
CHAT_ENABLE_DEMO_SEEDING=false

# Select one real provider and provide only its credentials.
VERIFICATION_PROVIDER=sms
SMS_PROVIDER=twilio
SMS_FROM=MobileMsg
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_FROM=
SMS_VONAGE_API_KEY=
SMS_VONAGE_API_SECRET=
SMS_VONAGE_FROM=
SMSRU_API_ID=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ALLOW_TEXT_PHONE_LINKING=false
TELEGRAM_REQUIRE_OWN_CONTACT=true
TELEGRAM_PAIRING_TOKEN_TTL_SECONDS=600
TELEGRAM_LINK_RESEND_COOLDOWN_SECONDS=60
TELEGRAM_ALLOW_RELINK=false

S3_ENDPOINT=https://s3.example.com
S3_PUBLIC_ENDPOINT=https://s3.example.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=messenger-media-production
S3_REGION=eu-west-1
S3_TLS_ENABLED=true
S3_FORCE_PATH_STYLE=false

REALTIME_HEARTBEAT_INTERVAL_MS=15000
REALTIME_HEARTBEAT_TIMEOUT_MS=45000

WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=
PUSH_ALLOW_TEST_ENDPOINT=false

APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=com.mobilemessenger.app
APNS_PRIVATE_KEY=
APNS_ENVIRONMENT=production
