// Copy this file to Config/Config.xcconfig only when you intentionally want a local override.
// For the iOS simulator, 127.0.0.1 points to the host Mac.
// For a physical device, replace 127.0.0.1 with your Mac's LAN IP.
// Bundled Debug/Release configs already point to the Cloudways production backend.

REST_BASE_URL = http\:\/\/127.0.0.1:8080/api
WEBSOCKET_URL = ws\:\/\/127.0.0.1:8080/realtime
TELEGRAM_BOT_USERNAME = verificMobileMessengerIOSbot

FEATURE_REALTIME = YES
FEATURE_PUSH = YES
FEATURE_MEDIA = NO
FEATURE_VERBOSE_LOGGING = YES
