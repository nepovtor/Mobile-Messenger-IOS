SLASH = /
LOCAL_API_SCHEME = http
LOCAL_API_HOST = 127.0.0.1
LOCAL_API_PORT = 8080
LOCAL_API_PREFIX = api
REST_BASE_URL = $(LOCAL_API_SCHEME):$(SLASH)$(SLASH)$(LOCAL_API_HOST):$(LOCAL_API_PORT)$(SLASH)$(LOCAL_API_PREFIX)
WEBSOCKET_URL = wss:$(SLASH)$(SLASH)ws.staging.example.com
FEATURE_REALTIME = YES
FEATURE_PUSH = YES
FEATURE_MEDIA = YES
FEATURE_VERBOSE_LOGGING = YES
