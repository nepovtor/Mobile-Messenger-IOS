SLASH = /
// Replace these placeholders with your production endpoints before App Store upload.
PRODUCTION_API_HOST = api.your-production-domain.com
PRODUCTION_WS_HOST = ws.your-production-domain.com
REST_BASE_URL = https:$(SLASH)$(SLASH)$(PRODUCTION_API_HOST)$(SLASH)api
WEBSOCKET_URL = wss:$(SLASH)$(SLASH)$(PRODUCTION_WS_HOST)
FEATURE_REALTIME = YES
FEATURE_PUSH = YES
FEATURE_MEDIA = YES
FEATURE_VERBOSE_LOGGING = NO
