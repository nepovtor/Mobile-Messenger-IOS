  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          },
          "code": {
            "type": [
              "string",
              "null"
            ]
          },
          "details": {}
        }
      },
      "AuthRequest": {
        "type": "object",
        "required": [
          "method",
          "contact"
        ],
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "phone",
              "email"
            ]
          },
          "contact": {
            "type": "string"
          }
        }
      },
      "AuthVerify": {
        "type": "object",
        "required": [
          "method",
          "contact",
          "code"
        ],
        "properties": {
          "method": {
            "type": "string"
          },
          "contact": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "required": [
          "token",
          "userID",
          "displayName"
        ],
        "properties": {
          "token": {
            "type": "string"
          },
          "userID": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "phone": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Contact": {
        "type": "object",
        "required": [
          "id",
          "displayName"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "phone": {
            "type": [
              "string",
              "null"
            ]
          },
          "directChatID": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        }
      },
      "ChatSummary": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "lastMessagePreview": {
            "type": [
              "string",
              "null"
            ]
          },
          "lastActivity": {
            "type": "string",
            "format": "date-time"
          },
          "unreadCount": {
            "type": "integer"
          },
          "typingParticipants": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Message": {
        "type": "object",
        "required": [
          "id",
          "chatID",
          "authorID",
          "kind",
          "status",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "messageID": {
            "type": "string",
            "format": "uuid"
          },
          "chatID": {
            "type": "string",
            "format": "uuid"
          },
          "authorID": {
            "type": "string",
            "format": "uuid"
          },
          "authorName": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "text",
              "image"
            ]
          },
          "text": {
            "type": [
              "string",
              "null"
            ]
          },
          "mediaID": {
            "type": [
              "string",
              "null"
            ]
          },
          "mediaURL": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Location": {
        "type": "object",
        "properties": {
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          },
          "accuracy": {
            "type": [
              "number",
              "null"
            ]
          },
          "updatedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "isSharing": {
            "type": "boolean"
          }
        }
      }
    }
  }
